NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://localhost:3001
API_PUBLIC_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4100
MONGODB_URI=mongodb://127.0.0.1:27017/ostras_rewards?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
UPLOAD_DIR=./uploads
# Use mongodb on Render to persist private images in Atlas GridFS.
IMAGE_STORAGE=disk
MAX_UPLOAD_MB=8
REWARD_POINTS=100
N8N_WEBHOOK_URL=
N8N_CALLBACK_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-private-admin-password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
