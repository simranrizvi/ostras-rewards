{
  "name": "Ostras Product Expiry and Reward",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ostras-expiry-reward",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "6f001fa5-72b8-4eac-9e4e-40da86aeb71b",
      "name": "Receive verified submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300],
      "webhookId": "ostras-expiry-reward",
      "credentials": {
        "httpHeaderAuth": { "id": "replace-after-import", "name": "Ostras Automation Secret" }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json.body;\nconst dateText = item.expiryDate;\nconst validDate = typeof dateText === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(dateText);\nconst expiryDate = validDate ? new Date(`${dateText}T00:00:00.000Z`) : null;\nconst today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\nconst confidence = Number(item.confidence || 0);\nconst isExpired = Boolean(expiryDate && expiryDate < today);\nconst readable = Boolean(expiryDate && confidence >= 0.78);\nreturn [{ json: { submissionId: item.submissionId, userId: item.userId, expiryDate: validDate ? dateText : null, confidence, isExpired, note: readable ? (isExpired ? 'Product expiry date has passed.' : 'Product is within its expiry date.') : (item.note || 'Expiry date was unclear; admin review is needed.') } }];"
      },
      "id": "464b5484-f56f-452d-a2b0-259245554f6a",
      "name": "Compare expiry date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4100/api/submissions/automation/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { submissionId: $json.submissionId, expiryDate: $json.expiryDate, confidence: $json.confidence, isExpired: $json.isExpired, note: $json.note } }}",
        "options": { "timeout": 15000 }
      },
      "id": "bbdf4a24-6845-4757-a6c7-2dd395fa0c80",
      "name": "Update the same user reward",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "replace-after-import", "name": "Ostras Automation Secret" }
      }
    }
  ],
  "connections": {
    "Receive verified submission": {
      "main": [[{ "node": "Compare expiry date", "type": "main", "index": 0 }]]
    },
    "Compare expiry date": {
      "main": [[{ "node": "Update the same user reward", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
